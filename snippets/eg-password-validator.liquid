{% comment %} 
    EG Password Valdiator
    © 2022 EcomGraduates
    https://wwww.ecomgraduates.com 
{% endcomment %}

{% liquid
    assign text_min_chars           = 'At least 6 Character'
    assign text_lower_upper_case    = 'Lowercase &amp; Uppercase'
    assign text_number_0_9          = 'Number (0-9)'
    assign text_special_char        = 'Special Character (!@#$%^&*)'
%}

{% if request.page_type == 'customers/register' %}
<style>
#form-password-show-hide {
    position: absolute;
    right: 0;
    margin: 0;
    display: flex;
    min-width: auto;
    padding-left: 16px;
    padding-right: 16px;
}

#form-password-requirments-list {
    padding: 0;
    margin: 0;
    font-size: .9em;
}

#form-password-requirments-list li {
    display: flex;
    align-items: center;
}

/* Bootstrap Progress Bar */
@keyframes progress-bar-stripes {
    0% {
        background-position-x: 1rem;
    }
}

.progress {
    --bs-progress-height: 1rem;
    --bs-progress-font-size: 0.75rem;
    --bs-progress-bg: #e9ecef;
    --bs-progress-border-radius: 0.375rem;
    --bs-progress-box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.075);
    --bs-progress-bar-color: #fff;
    --bs-progress-bar-bg: #0d6efd;
    --bs-progress-bar-transition: width 0.6s ease;
    display: flex;
    height: var(--bs-progress-height);
    overflow: hidden;
    font-size: var(--bs-progress-font-size);
    background-color: var(--bs-progress-bg);
    border-radius: var(--bs-progress-border-radius);
}
  
.progress-bar {
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    color: var(--bs-progress-bar-color);
    text-align: center;
    white-space: nowrap;
    background-color: var(--bs-progress-bar-bg);
    transition: var(--bs-progress-bar-transition);
}

@media (prefers-reduced-motion: reduce) {
    .progress-bar {
        transition: none;
    }
}
  
.progress-bar-striped {
    background-image: linear-gradient(45deg, rgba(255, 255, 255, 0.15) 25%, transparent 25%, transparent 50%, rgba(255, 255, 255, 0.15) 50%, rgba(255, 255, 255, 0.15) 75%, transparent 75%, transparent);
    background-size: var(--bs-progress-height) var(--bs-progress-height);
}
  
.progress-bar-animated {
    animation: 1s linear infinite progress-bar-stripes;
} 

@media (prefers-reduced-motion: reduce) {
    .progress-bar-animated {
        animation: none;
    }
}
</style>

<script>
window.addEventListener('DOMContentLoaded', () => {
    const passwordElem = document.querySelector('input[name="customer[password]"]')

    showPassword = false

    passwordElem.parentElement.insertAdjacentHTML('beforeend', `
        <button id="form-password-show-hide" class="btn btn-secondary button button--secondary" aria-hidden="true" type="button" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
                <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="24" fill="currentColor" class="bi bi-eye-slash" viewBox="0 0 16 16" hidden>
                <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z"/>
                <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z"/>
                <path d="M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z"/>
            </svg>
        </button>
    `)

    document.querySelector('#form-password-show-hide').addEventListener('click', () => {
        showPassword = !showPassword

        if (showPassword) {
            document.querySelector('#form-password-show-hide svg.bi-eye').setAttribute('hidden', 'hidden')
            document.querySelector('#form-password-show-hide svg.bi-eye-slash').removeAttribute('hidden')
            passwordElem.setAttribute('type', 'text')
        } else {
            document.querySelector('#form-password-show-hide svg.bi-eye').removeAttribute('hidden')
            document.querySelector('#form-password-show-hide svg.bi-eye-slash').setAttribute('hidden', 'hidden')
            passwordElem.setAttribute('type', 'password')
        }
    })

    passwordElem.setAttribute('minlength', '6')

    passwordElem.parentElement.insertAdjacentHTML('afterend', `
        <div 
            class="progress" 
            style="height: .5rem; margin: 16px 0 8px;">
            <div 
                id="form-password-progress-bar" 
                class="progress-bar" 
                role="progressbar" 
                aria-valuenow="0" 
                aria-valuemin="0" 
                aria-valuemax="100" 
                aria-label="Password strength checker"
                style="width: 0%">
            </div>
        </div> 
        <ul 
            id="form-password-requirments-list"
            class="">
            <li id="form-password-eight-character">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-dot me-0" viewBox="0 0 16 16">
                    <path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16" style="color: green" hidden>
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                </svg>
                At least 6 characters
            </li>
            <li id="form-password-low-upper-case" class="d-flex align-items-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-dot me-0" viewBox="0 0 16 16">
                    <path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16" style="color: green" hidden>
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                </svg>
                Lowercase &amp; Uppercase
            </li>
            <li id="form-password-one-number">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-dot me-0" viewBox="0 0 16 16">
                    <path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16" style="color: green"  hidden>
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                </svg>
                Number (0-9)
            </li>
            <li id="form-password-one-special-char">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-dot me-0" viewBox="0 0 16 16">
                    <path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check" viewBox="0 0 16 16" style="color: green" hidden>
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/>
                </svg>
                Special character (!@#$%^&*)
            </li>
        </ul>   
    `)

    passwordElem.addEventListener('input', () => {
        let strength = 0;

        // If password is greater/equal than 6
        if (passwordElem.value.length >= 6) {
            strength += 1;
            document.querySelector('#form-password-eight-character svg.bi-dot').setAttribute('hidden', 'hidden')
            document.querySelector('#form-password-eight-character svg.bi-check').removeAttribute('hidden')
        } else {
            document.querySelector('#form-password-eight-character svg.bi-dot').removeAttribute('hidden')
            document.querySelector('#form-password-eight-character svg.bi-check').setAttribute('hidden', 'hidden')
        }

        // If password contains both lower and uppercase characters
        if (passwordElem.value.match(/([a-z].*[A-Z])|([A-Z].*[a-z])/)) {
            strength += 1;
            document.querySelector('#form-password-low-upper-case svg.bi-dot').setAttribute('hidden', 'hidden')
            document.querySelector('#form-password-low-upper-case svg.bi-check').removeAttribute('hidden')
        } else {
            document.querySelector('#form-password-low-upper-case svg.bi-dot').removeAttribute('hidden')
            document.querySelector('#form-password-low-upper-case svg.bi-check').setAttribute('hidden', 'hidden')
        }

        // If it has numbers and characters
        if (passwordElem.value.match(/([0-9])/)) {
            strength += 1;
            document.querySelector('#form-password-one-number svg.bi-dot').setAttribute('hidden', 'hidden')
            document.querySelector('#form-password-one-number svg.bi-check').removeAttribute('hidden')
        } else {
            document.querySelector('#form-password-one-number svg.bi-dot').removeAttribute('hidden')
            document.querySelector('#form-password-one-number svg.bi-check').setAttribute('hidden', 'hidden')
        }

        // If it has one special character
        if (passwordElem.value.match(/([!,%,&,@,#,$,^,*,?,_,~])/)) {
            strength += 1;
            document.querySelector('#form-password-one-special-char svg.bi-dot').setAttribute('hidden', 'hidden')
            document.querySelector('#form-password-one-special-char svg.bi-check').removeAttribute('hidden')
        } else {
            document.querySelector('#form-password-one-special-char svg.bi-dot').removeAttribute('hidden')
            document.querySelector('#form-password-one-special-char svg.bi-check').setAttribute('hidden', 'hidden')
        }

        const progressBar = document.querySelector('#form-password-progress-bar')

        switch (strength) {
            case 0: 
                progressBar.style.backgroundColor = 'transparent'
                progressBar.style.width = '0%';
                progressBar.setAttribute('aria-valuenow', '0')
                break;
            case 1: 
                progressBar.style.backgroundColor = '#dc3545'
                progressBar.style.width = '25%';
                progressBar.setAttribute('aria-valuenow', '20')
                break;
            case 2: 
                progressBar.style.backgroundColor = '#ffc107'
                progressBar.style.width = '50%';
                progressBar.setAttribute('aria-valuenow', '40')
                break;
            case 3: 
                progressBar.style.backgroundColor = '#ffc107'
                progressBar.style.width = '75%';
                progressBar.setAttribute('aria-valuenow', '60')
                break;
            case 4: 
                progressBar.style.backgroundColor = '#198754'
                progressBar.style.width = '100%';
                progressBar.setAttribute('aria-valuenow', '100')
                break;
        }
    })

})
</script>
{% endif %}