{{ 'booking-time.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopfy-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-booking-section page-width" id="{{ section.settings.section_id }}">
  <div class="card">
    <div class="main">
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
      <p class="text m-0">{{ section.settings.text }}</p>
      <div class="schdule-time">
        <h1 class="time-heading m-0">{{ section.settings.select_time_heading }}</h1>
        <div class="date-time-wrapper">
          <input type="datetime-local" class="date-time">
          <p class="date-error m-0 error">Please input date and time correctly for a schedule.</p>
        </div>
      </div>
    </div>
    <div class="text-area">
      <div class="cleaning-service">
        <div class="cleaning-main">
          <h1 class="cleaning-heading heading m-0">{{ section.settings.cleaning_service_heading }}</h1>
          <p class="cleaning-text m-0">{{ section.settings.cleaning_service_text }}</p>
        </div>
        <div class="button-wrapper">
          <button class="book-call">{{ section.settings.proceed_text }}</button>
        </div>
      </div>
      <div class="need-help">
        <h1 class="need-help-heading heading m-0">{{ section.settings.help_heading }}</h1>
        <p class="need-help-text m-0">{{ section.settings.help_text }}</p>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Booking Time",
  "tag": "section",
  "class": "shopify-section--booking-time shopify-section booking-online",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "select_time_heading",
      "label": "Select Time Heading"
    },
    {
      "type": "text",
      "id": "cleaning_service_heading",
      "label": "Cleaning Service Heading"
    },
    {
      "type": "text",
      "id": "cleaning_service_text",
      "label": "Cleaning Service Text"
    },
    {
      "type": "text",
      "id": "proceed_text",
      "label": "Proceed Text"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help Heading"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help Text"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Booking Time",
      "settings": {
        "select_time_heading": "Select a Time for a schedule."
      }
    }
  ]
}
{% endschema %}
