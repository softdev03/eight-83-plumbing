{{ 'video-new.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .overlay {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .overlay {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-video-new">
    <div class="overlay page-width">
        <div class="announcement">
            <div class="pulse"></div>
            <p class="announce_text">{{ section.settings.announce_text }}</p>
        </div>
        <div class="heading">{{ section.settings.heading }}</div>
        <p class="text">{{ section.settings.text }}</p>
        <div class="buttons">
            <a href="{{ section.settings.quote_link }}" class="quote_button">{{ section.settings.quote_text }}</a>
            <a href="{{ section.settings.emergency_link }}" class="emergency_button">{{ section.settings.emergency_text }}</a>
        </div>
    </div>
    <video muted autoplay playsinline loop>
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="video/{{ source.format }}">
      {%- endfor -%}
    </video>
</div>
{% schema %}
{
  "name": "Video New",
  "tag": "section",
  "class": "shopify-section--video-new",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "video_url",
      "id": "video_link",
      "label": "Video Link",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "text",
      "id": "announce_text",
      "label": "Announce Text"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "Quote Link"
    },
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote Text"
    },
    {
      "type": "url",
      "id": "emergency_link",
      "label": "Emergency Link"
    },
    {
      "type": "text",
      "id": "emergency_text",
      "label": "Emergency Text"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Video New",
      "settings": {}
    }
  ]
}
{% endschema %}
