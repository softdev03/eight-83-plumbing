{{ 'enquiry-confirm.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
		background-color: {{ section.settings.bg_color }};
		color: {{ section.settings.text_color }};
  }
	#shopify-section-{{ section.id }} .link {
		background-color: {{ section.settings.button_bg_color |  default : 'transparent' }};
		color: {{ section.settings.button_text_color |  default : 'transparent' }};
		border: 1px solid {{ section.settings.button_border_color |  default : 'transparent' }};
		border-radius: {{ section.settings.button_border_radius }}px;
	}
	#shopify-section-{{ section.id }} .link:hover {
		background-color: {{ section.settings.button_bg_color_hover |  default : 'transparent' }};
		color: {{ section.settings.button_text_color_hover |  default : 'transparent' }};
		border-color: {{ section.settings.button_border_color_hover |  default : 'transparent' }};
	}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-enquiry-confirm page-width align-{{ section.settings.text_align }}">
	{%- if section.settings.icon != blank -%}
		<div class="icon">
			<img src="{{ section.settings.icon |  img_url: '120x' }}" alt="" width="120px" height="auto">
		</div>
	{%- endif -%}
	{%- if section.settings.heading != blank -%}
		<h1 class="heading">{{ section.settings.heading }}</h1>
	{%- endif -%}
	{%- if section.settings.blurb_text != blank -%}
		<div class="blurb-text">{{ section.settings.blurb_text }}</div>
	{%- endif -%}
	{%- if section.settings.button_text != blank -%}
		<a href="{% if section.settings.button_link != blank %} {{ section.settings.button_link }} {% else %} / {% endif %}" class="link">{{ section.settings.button_text }}</a>
	{%- endif -%}
</div>
{% schema %}
{
  "name": "Enquiry Confirm",
  "tag": "section",
  "class": "shopify-section--enquiry-confirm",
  "settings": [
		{
			"type": "image_picker",
			"id": "icon",
			"label": "Icon"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading"
		},
		{
			"type": "richtext",
			"id": "blurb_text",
			"label": "Blurb Text"
		},
		{
			"type": "text",
			"id": "button_text",
			"label": "Button Text"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "Button Link",
			"default": "/"
		},
		{
			"type": "color",
			"id": "bg_color",
			"label": "Background Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "button_bg_color",
			"label": "Button Background Color",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "button_text_color",
			"label": "Button Text Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "button_border_color",
			"label": "Button Border Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "button_bg_color_hover",
			"label": "Button Background Color when Hover",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "button_text_color_hover",
			"label": "Button Text Color when Hover",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "button_border_color_hover",
			"label": "Button Border Color when Hover",
			"default": "#000000"
		},
		{
			"type": "range",
			"id": "button_border_radius",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Button Border Radius",
			"default": 0
		},
		{
			"type": "text_alignment",
			"id": "text_align",
			"label": "Text Align"
		},
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Enquiry Confirm",
      "settings": {}
    }
  ]
}
{% endschema %}
