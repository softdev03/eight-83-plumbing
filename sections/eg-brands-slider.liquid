    EG Brands Slider
    © 2023 EcomGraduates
    https://www.ecomgraduates.com 
{% endcomment %}

<style>
    /* General styles */
    .img-fluid {
        max-width: 100%;
        height: auto;
    }

    /* Section styling */
    .eg-brands-slider {
        overflow: hidden;
    }
    
    .eg-brands-slider-list {
        list-style: none;
        display: flex;
    }

    .eg-brands-slider-item {
        flex-shrink: 0;
    }

    .eg-brands-slider-item img {
        transition: all .2s ease-out;
    }

    .eg-brands-slider-item a:hover img {
        opacity: .7;
    }

    /* Styles based on settings */
    #eg-brands-slider-{{ section.id }} {
        {% unless section.settings.bg_color == 'rgba(0,0,0,0)' %}
            background-color: {{ section.settings.bg_color }};
        {% endunless %}
        padding-top: {{ section.settings.pt }}rem;
        padding-bottom: {{ section.settings.pb }}rem;
        margin-top: {{ section.settings.mt }}rem;
        margin-bottom: {{ section.settings.mb }}rem;
    }

    #eg-brands-slider-{{ section.id }} .eg-brands-slider-item {
        padding-left: {{ section.settings.gap }}px;
        padding-right: {{ section.settings.gap }}px;
    }
</style>

<script>
window.addEventListener('DOMContentLoaded', () => {
    const initSlider = () => {
        const list = document.querySelector('#eg-brands-slider-{{ section.id }} .eg-brands-slider-list');
        const items = list.querySelectorAll('.eg-brands-slider-item');
        const totalWidth = Array.from(items).reduce((total, item) => total + item.offsetWidth, 0);
        
        // Duplicate the items to allow for continuous scrolling.
        list.innerHTML += list.innerHTML;

        const sliderDirection = {{ section.settings.slider_direction | json }};
        let animation;

        if (sliderDirection === 'left') {
            animation = list.animate([
                { transform: 'translateX(0px)' },
                { transform: `translateX(-${totalWidth}px)` }
            ], {
                duration: {{ section.settings.animation_duration | times: 1000 }},
                iterations: Infinity
            });
        } else {
            // Start from a negative offset when moving right to create the illusion of infinite scrolling.
            list.style.transform = `translateX(-${totalWidth}px)`;
            animation = list.animate([
                { transform: `translateX(-${totalWidth}px)` },
                { transform: 'translateX(0px)' }
            ], {
                duration: {{ section.settings.animation_duration | times: 1000 }},
                iterations: Infinity
            });
        }

        list.addEventListener('mouseover', () => animation.pause());
        list.addEventListener('mouseleave', () => animation.play());
    };

    initSlider();

    document.addEventListener('shopify:section:load', (event) => {
        if (event.detail.sectionId === '{{ section.id }}') {
            initSlider();
        }
    });
});
</script>

  
<section id="eg-brands-slider-{{ section.id }}" class="eg-brands-slider">
    <ul class="eg-brands-slider-list" aria-label="{{ section.settings.list_name }}">
        {% for block in section.blocks %}
            <li class="eg-brands-slider-item">
                {% unless block.settings.url == blank %}
                    <a href="{{ block.settings.url }}">
                {% endunless %}
                {% if block.settings.svg == blank %}
                    {% assign img_height_x2 = section.settings.img_height | times: 2 %}
                    <img
                        class="img-fluid"
                        src="{{ block.settings.img | image_url: height: img_height_x2 }}"
                        alt="{{ block.settings.img.alt }}"
                        width="{{ section.settings.img_height | times: block.settings.img.aspect_ratio | round }}"
                        height="{{ section.settings.img_height }}"
                        loading="lazy" >
                {% else %}
                    {{ block.settings.svg }}
                {% endif %}
                {% unless block.settings.url == blank %}
                    </a>
                {% endunless %}
            </li>
        {% endfor %}
    </ul>
</section>


{% schema %}
{
    "name": "EG - Brands Slider",
    "settings": [
        {
            "type": "header",
            "content": "General"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background color"
        },
        {
            "type": "text",
            "id": "img_height",
            "label": "Image height (px)",
            "default": "70",
            "info": "NOTE. Images will be cropped based on their aspect ratio."
        },

      {
            "type": "select",
            "id": "slider_direction",
            "label": "Slider Direction",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ],
            "default": "right",
            "info": "Select the direction the slider will move."
        },
      
        {
            "type": "text",
            "id": "list_name",
            "label": "List name",
            "default": "Brands list",
            "info": "Used for accessibility purposes"
        },
        {
            "type": "header",
            "content": "Effect"
        },
        {
            "type": "range",
            "id": "animation_duration",
            "label": "Animation duration",
            "min": 0,
            "max": 30,
            "step": 1,
            "default": 10,
            "unit": "sec",
            "info": "NOTE: Please click the \"Save\" button in order to view the changes."
        },
        {
            "type": "select",
            "id": "animation_direction",
            "label": "Animation direction",
            "default": "left",
            "options": [
                {
                    "value": "left",
                    "label": "Left"
                },
                {
                    "value": "right",
                    "label": "Right"
                }
            ]
        },
        {
            "type": "header",
            "content": "Gap"
        },
        {
            "type": "range",
            "id": "gap",
            "label": "Gap (px)",
            "info": "Space between images",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 16
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "pt",
            "label": "Padding top",
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 1
        },
        {
            "type": "range",
            "id": "pb",
            "label": "Padding bottom",
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 1
        },
        {
            "type": "range",
            "id": "mt",
            "label": "Margin top",
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 0
        },
        {
            "type": "range",
            "id": "mb",
            "label": "Margin bottom",
            "min": 0,
            "max": 12,
            "step": 1,
            "default": 0
        }
    ],
    "blocks": [
        {
            "type": "block",
            "name": "Block",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "img",
                    "label": "Image"
                },
                {
                    "type": "html",
                    "id": "svg",
                    "label": "SVG",
                    "info": "Paste SVG code here"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "URL"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "EG - Brands Slider",
            "category": "Images"
        }
    ]
}
{% endschema %}
