{{ 'enquiry-form.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
    #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.bg_color }};
    }
  #shopify-section-{{ section.id }} .shopify-enquiry-form {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .shopify-enquiry-form {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-enquiry-form page-width" id="{{ section.settings.section_id }}">
    <div class="intro">
        <h1 class="heading font-800 line-height-1_1 text-upper m-0">{{ section.settings.heading }}</h1>
        <div class="text line-height-1_1">{{ section.settings.text }}</div>
        <div class="image">
            <img src="{{ section.settings.image  |  img_url: '1000x'}}" alt="" width="auto" height="auto">
        </div>
    </div>
    <form action="" class="form">
        <input type="text" name="name" id="name" placeholder="Name" required class="w-45 line-height-1_1 font-500">
        <input type="text" name="phone" id="phone" class="w-45 line-height-1_1 font-500" placeholder="Phone" required>
        <input type="email" name="email" id="email" class="w-45 line-height-1_1 font-500" placeholder="Email" required>
        <select name="jobtype" id="jobtype" class="w-45 line-height-1_1 font-500">
            <option value="" disabled selected class="line-height-1_1 font-500">Job Type</option>
            {%- assign blocks = section.blocks |  where: 'type', 'job_type' -%}
            {%- for block in blocks -%}
              <option value="{{ block.settings.text }}" class="line-height-1_1 font-500">{{ block.settings.text }}</option>
            {%- endfor -%}
        </select>
        <select name="service" id="service" class="w-45 line-height-1_1 font-500">
            <option value="" disabled selected class="line-height-1_1 font-500">Choose your service</option>
            {%- assign blocks = section.blocks |  where: 'type', 'service' -%}
            {%- for block in blocks -%}
              <option value="{{ block.settings.text }}" class="line-height-1_1 font-500">{{ block.settings.text }}</option>
            {%- endfor -%}
        </select>
        <input type="text" name="suburb" id="suburb" class="w-45 line-height-1_1 font-500" placeholder="Suburb">
        <textarea name="message" id="message" cols="30" rows="1" class="w-100 line-height-1_1 font-600" placeholder="Your Message"></textarea>
        <input type="submit" value="send enquiry" class="w-100 text-upper line-height-1_1 font-600 submit">
    </form>
</div>
{% schema %}
  {
    "name": "Enquiry Form",
    "tag": "section",
    "class": "shopify-section--enquiry-form",
    "settings": [
        {
          "type": "text",
          "id": "section_id",
          "label": "Section Id"
        },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "header",
        "content": "Padding Settings"
      },
      {
        "type": "range",
        "id": "desktop_padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Desktop Padding Top",
        "default": 50
      },
      {
        "type": "range",
        "id": "desktop_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Desktop Padding Bottom",
        "default": 50
      },
      {
        "type": "range",
        "id": "mobile_padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Mobile Padding Top",
        "default": 50
      },
      {
        "type": "range",
        "id": "mobile_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Mobile Padding Bottom",
        "default": 50
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Bg Color",
        "default": "#000000"
      },
    ],
    "blocks": [
      {
        "name": "Service",
        "type": "service",
        "settings": [
           {
             "type": "text",
             "id": "text",
             "label": "Text"
           }
        ]
      },
      {
        "name": "Job Type",
        "type": "job_type",
        "settings": [
            {
              "type": "text",
              "id": "text",
              "label": "Text"
            },
        ]
      }
    ],
    "presets": [
      {
        "name": "Enquiry Form",
        "settings": {
        }
      }
    ]
  }
{% endschema %}