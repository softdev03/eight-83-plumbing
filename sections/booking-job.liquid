{{ 'booking-job.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-booking-job page-width" id="{{ section.settings.section_id }}">
  <div class="card">
    <div class="heading-container">
      {%- assign pieces = section.settings.phone_number | split: ' ' -%}
      <div class="phone-number-wrapper pulse">
        {%- if section.settings.phone_icon != blank -%}
          <img src="{{ section.settings.phone_icon |  img_url: '40x' }}" alt="" width="40px" height="40px">
        {%- endif -%}
        <div class="phone-number-text">
          {%- for piece in pieces -%}
            <p class="m-0">{{ piece }}</p>
          {%- endfor -%}
        </div>
      </div>
    </div>
    <div class="main-content">
      <div class="input-area">
        <a href="{{ section.settings.prev_section_id }}" class="back-step">{{ section.settings.prev_step }}</a>
        <div class="job-setting">
          <h1 class="job-setting-heading m-0">{{ section.settings.tell_us_your_job_heading }}</h1>
          <p class="job-setting-text m-0">{{ section.settings.tell_us_your_job_text }}</p>
          <div class="name item-wrapper">
            {%- if section.settings.name_heading != blank -%}
              <h1 class="name-heading sub-heading m-0">{{ section.settings.name_heading }}</h1>  
            {%- endif -%}
            <input type="text" class="name-input text-input" placeholder="{{ section.settings.name_placeholder }}">
            <p class="name-error error m-0">{{ section.settings.name_err_msg }}</p>
          </div>
          <div class="phone-number item-wrapper">
            {%- if section.settings.phone_heading != blank -%}
              <h1 class="phone-heading sub-heading m-0">{{ section.settings.phone_heading }}</h1>  
            {%- endif -%}
            <input type="text" class="phone-input text-input" placeholder="{{ section.settings.phone_placeholder }}">
            <p class="phone-error error m-0">{{ section.settings.phone_err_msg }}</p>
          </div>
          <div class="job-address item-wrapper">
            <h1 class="job-address-heading sub-heading m-0">{{ section.settings.job_address_heading }}</h1>
            <input
              type="text"
              class="job-address-input text-input"
              placeholder="{{ section.settings.job_placeholder }}"
            >
            <p class="job-address-error error m-0">{{ section.settings.job_err_msg }}</p>
          </div>
          <div class="email-address item-wrapper">
            <h1 class="email-address-heading sub-heading m-0">{{ section.settings.email_address_heading }}</h1>
            <input
              type="text"
              class="email-address-input text-input"
              placeholder="{{ section.settings.email_placeholder }}"
            >
            <p class="email-address-error error m-0">{{ section.settings.email_err_msg }}</p>
          </div>
          <div class="cleaning-service-select item-wrapper">
            {%- if section.settings.cleaning_service_select_heading != blank -%}
              <h1 class="cleaning-service-heading sub-heading m-0">
                {{ section.settings.cleaning_service_select_heading }}
              </h1>
            {%- endif -%}
            {%- assign cleaningServiceItems = section.blocks | where: 'type', 'cleaning_servic_item' -%}
            <div class="cleaning-service-items">
              {%- for block in cleaningServiceItems -%}
                <p class="cleaning-service-item m-0 text-cap" title="{{ block.settings.text }}">
                  {{ block.settings.text }}
                </p>
              {%- endfor -%}
            </div>
            <p class="cleaning-service-error error m-0">Please select a service.</p>
          </div>
          <div class="your-place">
            <h1 class="m-0 your-place-heading sub-heading">{{ section.settings.tell_us_place_heading }}</h1>
            <div class="place-rooms">
              {%- assign rooms = section.blocks | where: 'type', 'room_sort' -%}
              {%- for block in rooms -%}
                <div class="room">
                  <button class="minus">-</button>
                  <p class="room-name m-0" native="{{ block.settings.text }}">0 of {{ block.settings.text }}</p>
                  <button class="plus">+</button>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
      <div class="text-area">
        <div class="cleaning-service">
          <div class="cleaning-service-main">
            <h1 class="m-0 cleaning-service-heading sub-heading">{{ section.settings.cleaning_service_heading }}</h1>
            <p class="m-0 cleaning-service-text">{{ section.settings.cleaning_service_text }}</p>
          </div>
          <div class="cleaning-service-button">
            <a href="{{ section.settings.target_section_id }}" class="next-step">{{ section.settings.next_step }}</a>
          </div>
        </div>
        <div class="need-help">
          <h1 class="m-0 need-help-heading sub-heading">{{ section.settings.help_heading }}</h1>
          {%- assign helpText = section.settings.help_text | split: '[phone number]' -%}
          <div class="need-help-text">
            {{ helpText.first -}}
            <div class="phone-number">
              {%- for piece in pieces -%}
                <p class="m-0">{{ piece }}</p>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
