        {% if button_text != blank %}
          {% if button_url contains "products/" %}
            {% if direct_add_to_cart %}
              {%- liquid assign productHandle = button_url | split: "products/" | last -%}
              {%- liquid assign product =  all_products[productHandle] -%}
  
              <form method="post" action="/cart/add/{{ product.selected_or_first_available_variant.id }}" id="product-form-{{ section.id }}" accept-charset="UTF-8" class="form" enctype="multipart/form-data" novalidate="novalidate" data-type="add-to-cart-form">
