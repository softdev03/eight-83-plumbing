      height: {{ video_height | times: video_scale_mobile | divided_by: 100 }}px;
      min-height: {{ video_height | times: video_scale_mobile | divided_by: 100 }}px;
    }
    .section_{{ section.id }} svg[data-name='play'] {
      width: {{ play_icon_size | times: play_icon_scale_mobile | divided_by: 100 }}px;
