{%- liquid
    assign content_heading = section.settings.content_heading
    assign bold_heading = section.settings.bold_heading
    assign heading_size = section.settings.heading_size
    assign heading_color = section.settings.heading_color
    assign top_content = section.settings.top_content
    assign top_content_size = section.settings.top_content_size
    assign show_content1 = section.settings.show_content1
    assign content1 = section.settings.content1
    assign content1_value = section.settings.content1_value
    assign show_content2 = section.settings.show_content2
    assign content2 = section.settings.content2
    assign content2_value = section.settings.content2_value
    assign show_content3 = section.settings.show_content3
    assign content3 = section.settings.content3
    assign content3_value = section.settings.content3_value
    assign progress_color_main = section.settings.progress_color_main
    assign progress_color_secondary = section.settings.progress_color_secondary
    assign content_size = section.settings.content_size
    assign progress_bar_size = section.settings.progress_bar_size
    assign bottom_content = section.settings.bottom_content
    assign bottom_content_size = section.settings.bottom_content_size
    assign button_text = section.settings.button_text
    assign button_url = section.settings.button_url
    assign direct_add_to_cart = section.settings.direct_add_to_cart
    assign button_bg = section.settings.button_bg
    assign button_color = section.settings.button_color
    assign show_hand = section.settings.show_hand
    assign play_button_bg = section.settings.play_button_bg
    assign play_icon = section.settings.play_icon
    assign play_icon_size = section.settings.play_icon_size
    
    assign section_top_padding = section.settings.section_top_padding
    assign section_bottom_padding = section.settings.section_bottom_padding
    assign progress_card_direction = section.settings.progress_card_direction
    assign video_count = section.settings.video_count
    assign video_height = section.settings.video_height
    assign text_align = section.settings.text_align
    
    assign spacing_scale_medium = section.settings.spacing_scale_medium
    assign progress_card_direction_medium = section.settings.progress_card_direction_medium
    assign video_count_medium = section.settings.video_count_medium
    assign video_scale_medium = section.settings.video_scale_medium
    assign play_icon_scale_medium = section.settings.play_icon_scale_medium
    assign progress_scale_medium = section.settings.progress_scale_medium
    assign text_align_medium = section.settings.text_align_medium
    
    assign spacing_scale_small = section.settings.spacing_scale_small
    assign progress_card_direction_small = section.settings.progress_card_direction_small
    assign video_count_small = section.settings.video_count_small
    assign video_scale_small = section.settings.video_scale_small
    assign play_icon_scale_small = section.settings.play_icon_scale_small
    assign progress_scale_small = section.settings.progress_scale_small
    assign text_align_small = section.settings.text_align_small
    
    assign spacing_scale_mobile = section.settings.spacing_scale_mobile
    assign progress_card_direction_mobile = section.settings.progress_card_direction_mobile
    assign video_count_mobile = section.settings.video_count_mobile
    assign video_scale_mobile = section.settings.video_scale_mobile
    assign play_icon_scale_mobile = section.settings.play_icon_scale_mobile
    assign progress_scale_mobile = section.settings.progress_scale_mobile
    assign text_align_mobile = section.settings.text_align_mobile
    
    assign section_bg = section.settings.section_bg
    assign section_bg_position = section.settings.section_bg_position
    assign section_mobile_bg = section.settings.section_mobile_bg
    assign section_mobile_bg_position = section.settings.section_mobile_bg_position
    assign overlay_color = section.settings.overlay_color
    assign overlay_opacity = section.settings.overlay_opacity
    assign custom_class = section.settings.custom_class
-%}

<style>
  a:empty, ul:empty, dl:empty, div:empty, section:empty, article:empty, p:empty, h1:empty, h2:empty, h3:empty, h4:empty, h5:empty, h6:empty {
    display: block!important;
  }
  .section_{{ section.id }} * {
    margin-top: 0px;
    margin-bottom: 0px;
  }
  cs {
    display: block;
    width: 100%;
    height: 10px;
  }
  .section_{{ section.id }} {
    padding-top: {{ section_top_padding }}px;
    padding-bottom: {{ section_bottom_padding }}px;
    padding-left: 20px;
    padding-right: 20px;
    position: relative;
    isolation: isolate;
  }
  .section_{{ section.id }}_pc_bg {
    position: absolute;
    inset: 0;
    background-image: url("{{ section_bg | image_url }}");
    background-position: {{ section_bg_position }};
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: {% if background_attachment %}fixed{% endif %};
    z-index: -3;
  }
  .section_{{ section.id }}_mobile_bg {
    position: absolute;
    inset: 0;
    background-image: url("{{ section_mobile_bg | image_url }}");
    background-position: {{ section_mobile_bg_position }};
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: {% if mobile_background_attachment %}fixed{% endif %};
    z-index: -2;
  }
  .section_{{ section.id }}_overlay {
    position: absolute;
    inset: 0;
    background-color: {{ overlay_color }};
    opacity: calc({{ overlay_opacity }} / 100);
    z-index: -1;
    user-select: none;
    pointer-events: none;
  }
  .section_{{ section.id }} .video_container {
    min-height: {{ video_height }}px;
    position: relative;
    width: 100%;
  }
  .section_{{ section.id }} .video_track {
    position: absolute;
    top: 0px;
    left: 30px;
    width: auto;
    user-select: none;
    height: {{ video_height }}px;
  }
  .section_{{ section.id }} .track_transition {
    transition: all ease 0.3s;
  }
  .section_{{ section.id }} .video_block {
    height: {{ video_height }}px;
    width: 320px;
    margin: 20px 15px;
    border-radius: 12px;
    overflow: hidden;
  }
  .section_{{ section.id }} svg[data-name='play'] {
    width: {{ play_icon_size }}px;
    height: {{ play_icon_size }}px;
    fill: {{ play_button_bg }};
    stroke: {{ play_button_bg }};
    cursor: pointer;
    background-color: {{ play_icon }};
    border-radius: 50%;
    opacity: .9;
    position: absolute;
    z-index: 2;
  }
  .section_{{ section.id }} svg[data-name='mute'],
  .section_{{ section.id }} svg[data-name='sound']{
    width: 25px;
    height: 25px;
    fill: {{ play_icon }};
    stroke: {{ play_icon }};
    cursor: pointer;
    background-color: {{ play_button_bg }};
    border-radius: 50%;
    opacity: .9;
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 4;
    padding: 4px;
    opacity: 0.5;
  }
  .section_{{ section.id }} .video_overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    user-select: none;
    pointer-events: none;
  }
  .section_{{ section.id }} .video_block video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .d_none {
    display: none;
  }
  .d_flex {
    display: flex;
  }
  .flex_row {
    flex-direction: row;
  }
  .flex_col {
    flex-direction: column;
  }
  .flex_col_r {
    flex-direction: column-reverse;
  }
  .center {
    align-items: center;
    justify-content: center;
  }
  .align_center {
    align-items: center;
  }
  .justify_center {
    justify-content: center;
  }
  .align_start {
    align-items: start;
  }
  .justify_start {
    justify-content: start;
  }
  .bold {
    font-weight: 600;
  }
  .capitalize {
    text-transform: capitalize;
  }
  .caps {
    text-transform: uppercase;
  }
  .w_full {
    width: 100%;
  }
  .flex_1 {
    flex: 1;
  }
  .flex_2 {
    flex: 2;
  }
  .gap_1 {
    gap: 10px;
  }
  .gap_2 {
    gap: 20px;
  }
  .gap_3 {
    gap: 30px;
  }
  .relative {
    position: relative;
  }
  .text_left,
  .text_left > * {
    text-align: left;
  }
  .text_center,
  .text_center > * {
    text-align: center;
  }
  .section_{{ section.id }} .heading {
    font-size: 32px;
    line-height: 1.1em;
  }
  .section_{{ section.id }} .heading.lg {
    font-size: 52px;
  }
  .section_{{ section.id }} .heading.sm {
    font-size: 24px;
  }
  .section_{{ section.id }} .body {
    font-size: 15px;
    line-height: 1.4em;
  }
  .section_{{ section.id }} .body.lg {
    font-size: 18px;
  }
  .section_{{ section.id }} .body.sm {
    font-size: 12px;
  }
  .section_{{ section.id }} .page_width {
    max-width: 1170px;
    margin: auto
  }
  .overflow_auto {
    overflow: auto;
  }
  .overflow_hidden {
    overflow: hidden;
  }
  .section_{{ section.id }} .centent_heading {
    color: {{ heading_color }};
  }
  .section_{{ section.id }} .section_data_container {
    padding: 15px 0px;
    border-bottom: solid 1px #ddd;
  }
  .section_{{ section.id }} .section_button {
    margin-top: 15px;
    background-color: {{ button_bg }};
    color: {{ button_color }};
    display: block;
    {% if show_hand %}
      padding: 10px 30px 10px 80px;
    {% else %}
      padding: 10px 30px 10px 30px;
    {% endif %}
    border-radius: 6px;
    position: relative;
    font-weight: 600;
    text-decoration: none;
    max-width: fit-content;
    cursor: pointer;
    border: none!important;
    box-shadow: none!important;
    outline: none!important;
    min-height: 45px;
  }
  .section_{{ section.id }} .section_button::before {
    {% if show_hand %}
      content: "";
    {% endif %}
    position: absolute;
    top: 50%;
    left: 30px;
    width: 30px;
    height: 20px;
    transform: translateY(-50%);
    background-image: url("https://cdn.shopify.com/s/files/1/0827/3870/8793/t/1/assets/button_hand.webp?v=1694327969");
    background-size: contain;
    background-position: center center;
  }
  .section_{{ section.id }} div.icon_progress[role=progressbar] {
    --value: 0;
    --percentage: var(--value);
    --primary: {{ progress_color_main }};
    --secondary: {{ progress_color_secondary }};
    --size: 300px;
    animation: progress 2s .5s forwards;
    width: {{ progress_bar_size }}px;
    height: {{ progress_bar_size }}px;
    border-radius: 50%;
    position: relative;
    overflow: hidden;
    display: grid!important;;
    place-items: center;
    transition: var(--value) ease 0.8s;
  }
  .section_{{ section.id }} div.icon_progress[role=progressbar]::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: conic-gradient(var(--primary) calc(var(--percentage) * 1%),var(--secondary) 0);
    mask: radial-gradient(white 55%,transparent 0);
    mask-mode: alpha;
    -webkit-mask: radial-gradient(#0000 55%,#000 0);
    -webkit-mask-mode: alpha;
    transition: all ease 0.8s;
  }
  .section_{{ section.id }} div.icon_progress[role=progressbar]::after {
    counter-reset: percentage var(--value);
    content: counter(percentage) "%";
    font-family: Helvetica,Arial,sans-serif;
    font-size: calc({{ progress_bar_size }}px / 3.333333);
    color: var(--primary);
    transition: all ease 0.8s;
  }

  @media only screen and (max-width:1170px) {
    .section_{{ section.id }} {
      padding-top: {{ section_top_padding | times: spacing_scale_medium | divided_by: 100 }}px;
      padding-bottom: {{ section_bottom_padding | times: spacing_scale_medium | divided_by: 100 }}px;
    }
    .section_{{ section.id }} .section_data_container {
      padding: calc(15px * {{ spacing_scale_medium }} / 100) 0px;
    }
    .s1170_w_full {
      width: 100%;
    }
    .s1170_flex_1 {
      flex: 1;
    }
    .s1170_flex_2 {
      flex: 2;
    }
    .s1170_gap_1 {
      gap: 10px;
    }
    .s1170_gap_2 {
      gap: calc(20px * {{ spacing_scale_medium }} / 100);
    }
    .s1170_gap_3 {
      gap: calc(30px * {{ spacing_scale_medium }} / 100);
    }
    .s1170_flex_row {
      flex-direction: row;
    }
    .s1170_flex_col {
      flex-direction: column;
    }
    .s1170_align_center {
      align-items: center;
    }
    .s1170_justify_center {
      justify-content: center;
    }
    .s1170_align_start {
      align-items: start;
    }
    .s1170_justify_start {
      justify-content: start;
    }
    .s1170_text_left,
    .s1170_text_left > * {
      text-align: left;
    }
    .s1170_text_center,
    .s1170_text_center > * {
      text-align: center;
    }
    .section_{{ section.id }} .heading {
      font-size: 30px;
    }
    .section_{{ section.id }} .heading.lg {
      font-size: 36px;
    }
    .section_{{ section.id }} .heading.sm {
      font-size: 24px;
    }
    .section_{{ section.id }} .body {
      font-size: 14px;
    }
    .section_{{ section.id }} .body.lg {
      font-size: 16px;
    }
    .section_{{ section.id }} .body.sm {
      font-size: 12px;
    }
    .s1170_d_none {
      display: none;
    }

    .section_{{ section.id }} .video_container,
    .section_{{ section.id }} .video_block,
    .section_{{ section.id }} .video_block video,
    .section_{{ section.id }} .video_track {
      height: {{ video_height | times: video_scale_medium | divided_by: 100 }}px;
      min-height: {{ video_height | times: video_scale_medium | divided_by: 100 }}px;
    }
    .section_{{ section.id }} svg[data-name='play'] {
      width: {{ play_icon_size | times: play_icon_scale_medium | divided_by: 100 }}px;
      height: {{ play_icon_size | times: play_icon_scale_medium | divided_by: 100 }}px;
    }
    .section_{{ section.id }} div.icon_progress[role=progressbar] {
      height: {{ progress_bar_size | times: progress_scale_medium | divided_by: 100 }}px;
      width: {{ progress_bar_size | times: progress_scale_medium | divided_by: 100 }}px;
    }
    .section_{{ section.id }} div.icon_progress[role=progressbar]::after {
      font-size: calc({{ progress_bar_size | times: progress_scale_medium | divided_by: 100 }}px / 3.333333);
    }
  }

  @media only screen and (max-width:900px) {
    .section_{{ section.id }} {
      padding-top: {{ section_top_padding | times: spacing_scale_small | divided_by: 100 }}px;
      padding-bottom: {{ section_bottom_padding | times: spacing_scale_small | divided_by: 100 }}px;
    }
    .section_{{ section.id }} .section_data_container {
      padding: calc(15px * {{ spacing_scale_small }} / 100) 0px;
    }
    .s900_w_full {
      width: 100%;
    }
    .s900_flex_1 {
      flex: 1;
    }
    .s900_flex_2 {
      flex: 2;
    }
    .s900_gap_1 {
      gap: 10px;
    }
    .s900_gap_2 {
      gap: calc(20px * {{ spacing_scale_small }} / 100);
    }
    .s900_gap_3 {
      gap: calc(30px * {{ spacing_scale_small }} / 100);
    }
    .s900_flex_row {
      flex-direction: row;
    }
    .s900_flex_col {
      flex-direction: column;
    }
    .s900_align_center {
      align-items: center;
    }
    .s900_justify_center {
      justify-content: center;
    }
    .s900_align_start {
      align-items: start;
    }
    .s900_justify_start {
      justify-content: start;
    }
    .s900_text_left,
    .s900_text_left > * {
      text-align: left;
    }
    .s900_text_center,
    .s900_text_center > * {
      text-align: center;
    }
    .section_{{ section.id }} .heading {
      font-size: 30px;
    }
    .section_{{ section.id }} .heading.lg {
      font-size: 36px;
    }
    .section_{{ section.id }} .heading.sm {
      font-size: 24px;
    }
    v.body {
      font-size: 14px;
    }
    .section_{{ section.id }} .body.lg {
      font-size: 16px;
    }
    .section_{{ section.id }} .body.sm {
      font-size: 12px;
    }
    .s900_d_none {
      display: none;
    }
    .mobile_overflow_hidden {
      overflow: hidden;
    }

    .section_{{ section.id }} .video_container,
    .section_{{ section.id }} .video_block,
    .section_{{ section.id }} .video_block video,
    .section_{{ section.id }} .video_track {
      height: {{ video_height | times: video_scale_small | divided_by: 100 }}px;
      min-height: {{ video_height | times: video_scale_small | divided_by: 100 }}px;
    }
    .section_{{ section.id }} svg[data-name='play'] {
      width: {{ play_icon_size | times: play_icon_scale_small | divided_by: 100 }}px;
      height: {{ play_icon_size | times: play_icon_scale_small | divided_by: 100 }}px;
    }
    .section_{{ section.id }} div.icon_progress[role=progressbar] {
      height: {{ progress_bar_size | times: progress_scale_small | divided_by: 100 }}px;
      width: {{ progress_bar_size | times: progress_scale_small | divided_by: 100 }}px;
    }
    .section_{{ section.id }} div.icon_progress[role=progressbar]::after {
      font-size: calc({{ progress_bar_size | times: progress_scale_small | divided_by: 100 }}px / 3.333333);
    }
