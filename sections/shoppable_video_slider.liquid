              {% if progress_card_direction_medium == "horizontal" %}s1170_flex_col{% else %}s1170_flex_row{% endif %} 
              {% if progress_card_directio_small == "horizontal" %}s900_flex_col{% else %}s900_flex_row{% endif %} 
              {% if progress_card_direction_mobile == "horizontal" %}s750_flex_col{% else %}s750_flex_row{% endif %} 
              ">
              <div class="icon_progress" role="progressbar" aria-valuenow="{{ content2_value }}" aria-valuemin="0" aria-valuemax="100"></div>
              <div class="flex_1 body {{ content_size }} {{ text_align }} {{ text_align_medium }} {{ text_align_small }} {{ text_align_mobile }}">{{ content2 }}</div>
            </div>
