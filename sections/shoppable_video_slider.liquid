  </div>
</section>

<script>
  (function() {
    let section = document.querySelector(".section_{{ section.id }}");
    
    // ============================================================================================================ Animating progressbar from 0

    let allProgress = Array.from(section.querySelectorAll("[role='progressbar']"));
    allProgress.forEach(element=>{
      let current = 0;
      let min = 0;
      let max = parseInt(element.getAttribute("aria-valuenow"));

      window.addEventListener("load", function() {
        let increment = setInterval(()=>{
          element.style.setProperty('--value', current);
          if (current < max) {
            current += 1;
          } else {
            clearInterval(increment)
          }
        }, 35)
      });
    })
  
    // ============================================================================================================ Playing video with SVG
  
    document.querySelectorAll("svg[data-name='play']").forEach(item=>{
      item.addEventListener("click", ()=>{
        document.querySelectorAll("svg[data-name='play']").forEach(play=>{
          play.parentElement.querySelector("video").pause();
          play.parentElement.querySelector("video").currentTime = 0;
          play.classList.remove("d_none")
        })
        item.classList.add("d_none");
        item.parentElement.querySelector("video").play();
      })
    })
  
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          entry.target.pause();
          entry.target.currentTime = 0;
          entry.target.parentElement.querySelector("svg[data-name='play']").classList.remove("d_none");
        }
      });
    }, {threshold: 0.5});
        
    document.querySelectorAll("video").forEach(item=>{
      observer.observe(item);
      item.addEventListener("click", ()=>{
        item.pause();
        item.parentElement.querySelector("svg[data-name='play']").classList.remove("d_none");
      })
    })
  
    // ============================================================================================================ Muting/Unmuting video
  
    document.querySelectorAll("svg[data-name='mute']").forEach(item=>{
      item.addEventListener("click", ()=>{
        item.classList.add("d_none");
        item.parentElement.querySelector("svg[data-name='sound']").classList.remove("d_none");
        item.parentElement.querySelector("video").muted = false;
      })
    })
    document.querySelectorAll("svg[data-name='sound']").forEach(item=>{
      item.addEventListener("click", ()=>{
        item.classList.add("d_none");
        item.parentElement.querySelector("svg[data-name='mute']").classList.remove("d_none");
        item.parentElement.querySelector("video").muted = true;
      })
    })
  
    // ============================================================================================================ Scrolling video series
    
    let container = section.querySelector(".video_container");
    let allTracks = Array.from(container.querySelectorAll(".video_track"));
    let track = allTracks[1];
    let preTrack = allTracks[0];
    let postTrack = allTracks[2];
    let scrolling = false;
    let currX, currY, oldX, oldY, startX, startY, oldPreX, oldPostX = 0;
    let blockCount = Array.from(preTrack.children).length;
    let video_width = 0;
    let scrollType = null;
    
    const video_sizer = () => {
      document.querySelectorAll(".video_block").forEach((video) => {
        if (window.innerWidth > 1170) {
          video_width = (parseInt(window.getComputedStyle(container, null).getPropertyValue("width"))- 60) / {{ video_count }} - 30;
        } else if (window.innerWidth > 900) {
          video_width = (parseInt(window.getComputedStyle(container, null).getPropertyValue("width"))- 60) / {{ video_count_medium }} - 30;
        } else if (window.innerWidth > 767) {
          video_width = (parseInt(window.getComputedStyle(container, null).getPropertyValue("width"))- 60) / {{ video_count_small }} - 30;
        } else {
          video_width = (parseInt(window.getComputedStyle(container, null).getPropertyValue("width"))- 60) / {{ video_count_mobile }} - 30;
        }
        video.style.width = `${video_width}px`;
      })
    }
    video_sizer()
  
    preTrack.style.left = `${blockCount * -(video_width + 30) + 30}px`;
    postTrack.style.left = `${blockCount * (video_width + 30) + 30}px`;
  
    window.addEventListener("resize", (e) => {
      video_sizer()
      notScrolling()
    })

    const moveSection = moveAmount => {
      document.querySelector("body").classList.add("mobile_overflow_hidden");
      track.style.left = `${oldX - moveAmount}px`;
      preTrack.style.left = `${oldPreX - moveAmount}px`;
      postTrack.style.left = `${oldPostX - moveAmount}px`;
    }

    const mouseMove = (e) => {
      if (scrolling) {
        currX  = e.clientX;
        currY  = e.clientY;
        let moveAmount = startX - currX;
        let moveVertical = Math.abs(startY - currY);
        console.log(moveVertical);

        if (window.innerWidth < 767) {

          if (!scrollType) {
            if (moveVertical > 30) {
              scrollType = "vert";
            } else if (Math.abs(moveAmount) > 10) {
              scrollType = "horz";
            }
          }

          if (scrollType == "horz") {
            moveSection(moveAmount);
          }
          
        } else {
          moveSection(moveAmount);
        }
      }
    }
    const mouseDown = (e) => {
      scrolling = true;
      startX = e.clientX;
      startY = e.clientY;
      oldX = parseInt(window.getComputedStyle( track , null).getPropertyValue( "left" ));
      oldPreX = parseInt(window.getComputedStyle( preTrack , null).getPropertyValue( "left" ));
      oldPostX = parseInt(window.getComputedStyle( postTrack , null).getPropertyValue( "left" ));
      [track, preTrack, postTrack].forEach(item=>item.classList.remove("track_transition"));
    }
  
    const notScrolling = () => {
      scrollType = null;
      scrolling = false;
      document.querySelector("body").classList.remove("mobile_overflow_hidden");
      [track, preTrack, postTrack].forEach(item=>item.classList.add("track_transition"));
      let left = parseInt(window.getComputedStyle( track , null).getPropertyValue( "left" ));
      
      for (let i = -20; i < 20; i++) {
        if ((-video_width / 2 ) - 15 < (left + (video_width + 30) * i) && (left + (video_width + 30) * i) < (video_width / 2) + 15) {
          let moveAmount = -(video_width + 30) * i + 30;
          track.style.left = `${moveAmount}px`;
          preTrack.style.left = `${moveAmount - blockCount * (video_width + 30)}px`;
          postTrack.style.left = `${moveAmount + blockCount * (video_width + 30)}px`;
          
          setTimeout(()=>{
            if (i < 0) {
              [track, preTrack, postTrack].forEach(item=>item.classList.remove("track_transition"));
              left = parseInt(window.getComputedStyle( track , null).getPropertyValue( "left" ));
              track.style.left = `${left - blockCount * (video_width + 30)}px`;
              preTrack.style.left = `${left - blockCount * 700}px`;
              postTrack.style.left = `${left}px`;
            } else if (i >= blockCount) {
              [track, preTrack, postTrack].forEach(item=>item.classList.remove("track_transition"));
              left = parseInt(window.getComputedStyle( track , null).getPropertyValue( "left" ));
              track.style.left = `${left + blockCount * (video_width + 30)}px`;
              preTrack.style.left = `${left}px`;
              postTrack.style.left = `${left + blockCount * 700}px`;
            }
          }, 300)
        }
        oldX, oldPreX, oldPostX = 0;
      }
    }


      
    container.addEventListener("mousedown", (e) => mouseDown(e));
    container.addEventListener("mousemove", (e) => mouseMove(e));
    container.addEventListener("mouseup", (e) => scrolling ? notScrolling() : null);
    container.addEventListener("mouseleave", (e) => scrolling ? notScrolling() : null);

              
    container.addEventListener("touchstart", (e) => mouseDown(e.touches[0]));
    container.addEventListener("touchmove", (e) => mouseMove(e.touches[0]));
    container.addEventListener("touchend", (e) => scrolling ? notScrolling() : null);
  
    // ============================================================================================================ Updating text custom transformation
  
    document.querySelectorAll("[data-rich-text]").forEach(text=>{
      text.innerHTML = text.textContent.replace(/~/g, "<cs></cs>");
    })
  })()
</script>

