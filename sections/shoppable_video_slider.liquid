  @media only screen and (max-width:767px) {
    .section_{{ section.id }} {
      padding-top: {{ section_top_padding | times: spacing_scale_mobile | divided_by: 100 }}px;
      padding-bottom: {{ section_bottom_padding | times: spacing_scale_mobile | divided_by: 100 }}px;
    }
    .section_{{ section.id }} .section_data_container {
      padding: calc(15px * {{ spacing_scale_mobile }} / 100) 0px;
    }
    .s750_w_full {
      width: 100%;
    }
    .s750_flex_1 {
      flex: 1;
    }
    .s750_flex_2 {
      flex: 2;
    }
    .s750_gap_1 {
      gap: 10px;
    }
    .s750_gap_2 {
      gap: calc(20px * {{ spacing_scale_mobile }} / 100);
    }
    .s750_gap_3 {
      gap: calc(30px * {{ spacing_scale_mobile }} / 100);
    }
    .s750_flex_row {
      flex-direction: row;
    }
    .s750_flex_col {
      flex-direction: column;
    }
    .s750_align_center {
      align-items: center;
    }
    .s750_justify_center {
      justify-content: center;
    }
    .s750_align_start {
      align-items: start;
    }
    .s750_justify_start {
      justify-content: start;
    }
    .s750_text_left,
    .s750_text_left > * {
      text-align: left;
    }
    .s750_text_center,
    .s750_text_center > * {
      text-align: center;
    }
    .section_{{ section.id }} .heading {
      font-size: 30px;
    }
    .section_{{ section.id }} .heading.lg {
      font-size: 36px;
    }
    .section_{{ section.id }} .heading.sm {
