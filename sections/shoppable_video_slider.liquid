                <input type="hidden" name="utf8" value="✓">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled="" class="product-variant-id">
        
                <div class="product-form__buttons">
                  <button id="ProductSubmitButton-" type="submit" name="add" class="section_button" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ button_text }}
