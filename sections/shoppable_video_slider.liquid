<section class="section_{{ section.id }} {{ custom_class }}">
  <div class="section_{{ section.id }}_pc_bg pc_bg {% if section_mobile_bg != blank %}s750_d_none{% endif %}"></div>
  <div class="section_{{ section.id }}_mobile_bg mobile_bg d_none {% if section_mobile_bg != blank %}s750_d_block{% endif %}"></div>
  <div class="section_{{ section.id }}_overlay transparent_overlay"></div>
  
  <div class="page_width">
    {% for block in section.blocks %}
      {% if block.type == "heading" %}
        
        {%- liquid 
          assign heading_below_gap = block.settings.heading_below_gap
          assign heading_color = block.settings.heading_color
          assign sub_heading_first = block.settings.sub_heading_first
          assign heading_gap = block.settings.heading_gap
          assign bold_heading = block.settings.bold_heading
          assign caps_heading = block.settings.caps_heading
          assign heading_alignment = block.settings.heading_alignment
          assign heading_size = block.settings.heading_size
          assign bold_sub_heading = block.settings.bold_sub_heading
          assign section_heading = block.settings.section_heading
          assign section_sub_heading = block.settings.section_sub_heading
        -%}
  
        <div class="heading_block w_full block_{{ block.id }}" {{ block.shopify_attributes }}>
          <style>
            .block_{{ block.id }}.heading_block {
              margin: 0px 0px {{ heading_below_gap }}px 0px;
              color: {{ heading_color }};
            }
            @media only screen and (max-width:1170px) {
              .block_{{ block.id }}.heading_block {
                margin: 0px 0px {{ heading_below_gap | times: spacing_scale_medium | divided_by: 100 }}px 0px;
              }
            }
            @media only screen and (max-width:900px) {
              .block_{{ block.id }}.heading_block {
                margin: 0px 0px {{ heading_below_gap | times: spacing_scale_small | divided_by: 100 }}px 0px;
              }
            }
            @media only screen and (max-width:767px) {
              .block_{{ block.id }}.heading_block {
                margin: 0px 0px {{ heading_below_gap | times: spacing_scale_mobile | divided_by: 100 }}px 0px;
              }
            }
          </style>
          <div class="d_flex {% if sub_heading_first %}flex_col_r{% else %}flex_col{% endif %} w_full  {{ heading_gap }}">
            <p
              data-rich-text
              class="{% if bold_heading %}bold{% endif %} {% if caps_heading %}caps{% endif %} capitalize {{ heading_alignment }} heading {{ heading_size }}"
            >
              {{ section_heading }}
            </p>
            <p
              data-rich-text
              class="{% if bold_sub_heading %}bold{% endif %} {% if caps_heading %}caps{% endif %} capitalize {{ heading_alignment }} body"
            >
              {{ section_sub_heading }}
            </p>
          </div>
        </div>
        
      {% endif %}
    {% endfor %}
    <div class="d_flex s750_flex_col center gap_3">
      <div class="flex_2 s900_flex_1 overflow_hidden video_container">
        {% for i in (1..3) %}
          <div class="video_track d_flex center ">
            {% for block in section.blocks %}
              {% if block.type == "video" %}
  
