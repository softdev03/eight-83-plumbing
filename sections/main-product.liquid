                                    <input type="hidden" name="product-id" value="{{ thisProduct.selected_or_first_available_variant.id }}">
                                    
                                    <div class="recommended_product_media">
                                      
                                      {% if block.settings.link_image %}
                                        <a href="/products/{{ thisProduct.handle }}" >
                                      {% endif %}
                                          <img class="recommended_product_image" src="{% if thisProduct.selected_or_first_available_variant.image != blank %}{{ thisProduct.selected_or_first_available_variant.image | image_url }}{% else %}{{ thisProduct.images.first | image_url }}{% endif %}" />
                                      {% if block.settings.link_image %}
                                        </a>
                                      {% endif %}
                                    </div>
                                    
                                    <div class="recommended_product_info">
                                      {% if block.settings.link_title %}
                                        <a href="/products/{{ thisProduct.handle }}" style="color: unset;text-decoration: none;">
                                      {% endif %}
                                          <p class="recommended_product_title">{{ thisProduct.title }}</p>
                                      {% if block.settings.link_title %}
                                        </a>
                                      {% endif %}
                                      <a href="/products/{{ thisProduct.handle }}" style="display:none!important">view details</a>
            
                                      {% if block.settings.show_atc %}
                                        {% unless thisProduct.has_only_default_variant %}
                                          <select class="recommended_product_form_options {{ product_form_id }}">
                                            {%- for variant in thisProduct.variants -%}
                                                <option data-image="{% if variant.image %}{{ variant.image | image_url }}{% elsif thisProduct.featured_image %}{{ thisProduct.featured_image | image_url }}{% else %}{{ thisProduct.images.first | image_url }}{% endif %}" data-price="{{ variant.price | money }}" data-compare="{{ variant.compare_at_price | money }}" value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money }}</option>
                                            {%- endfor -%}
                                          </select>
                                        {% endunless %}
                                        
                                        <button id="ProductSubmitButton-" type="submit" name="add" class="recommended_product_button {{ block.settings.button_type }}" value="{{ thisProduct.selected_or_first_available_variant.id }}">
                                          Add To Cart
                                        </button>
                                      {% endif %}
                                    </div>
                                
                                  </form>
                                </div>
                              {% endif %}
                            {% endfor %}
                          </div>
        
                          <div class="slide_nav_conainer">
                            {% for item in (1..item_count) %}
                              <div class="slide_nav"></div>
                            {% endfor %}
                          </div>
                    
                        </div>
                      </div>
            
                {% if block.settings.tab_mode %}
                    </div>
                  </details>
                {% endif %}

                <script>
                  (function(){
                    let block = document.querySelector(".block_{{ block.id }}");
                    let slideShowContentContainer = block.querySelector(".slideShow_content_container");
                    let allSlideNav = Array.from(block.querySelectorAll(".slide_nav"));
                    let prevButtons = block.querySelector(".prev");
                    let nextButtons = block.querySelector(".next");
                    let activeSlide = 1;
                    let blockCount = parseInt("{{ item_count }}");
            
                    allSlideNav[0].classList.add("active");

                    nextButtons.addEventListener("click", ()=>{
                      activeSlide < blockCount ? activeSlide += 1 : activeSlide = 1;
                      updateSlide();
                      updateNavigation();
                    })

                    prevButtons.addEventListener("click", ()=>{
                      activeSlide > 1 ? activeSlide -= 1 : activeSlide = blockCount;
                      updateSlide();
                      updateNavigation();
                    })
                    allSlideNav.forEach(slideNav =>{
                      slideNav.addEventListener("click", (event)=>{
                        activeSlide = allSlideNav.indexOf(event.target) + 1;
                        updateSlide();
                        updateNavigation();
                      })
                    })

                    function updateSlide() {
                      let transformFactor = `translateX(${-1 * (activeSlide - 1) * (100 / blockCount).toFixed(2)}%)`;
                      slideShowContentContainer.style.transform = transformFactor;
                    }
                    function updateNavigation() {
                      allSlideNav.forEach(slideNav=>{slideNav.classList.remove("active")});
                      allSlideNav[activeSlide - 1].classList.add("active");
                    }

                    {% if block.settings.show_atc %}
                      let productForms = block.querySelectorAll("[data-form-type='drawer_cart']");
                      productForms.forEach(productForm => {
                        let formSelect = productForm.querySelector(".recommended_product_form_options");
                        if (formSelect) {
                          let currentId = null;
                          let currentImage = null;
                          formSelect.addEventListener("change", ()=>{
                            Array.from(formSelect.children).forEach(option=>{
                              if (option.value == formSelect.value) {
                                  currentId = option.value;
                                  currentImage = option.dataset.image;
                              }
                            })
                            productForm.action = `/cart/add/${currentId}`;
                            productForm.querySelector("input[name='id']").value = currentId;
                            productForm.querySelector("button[type='submit']").value = currentId;
                            
                            productForm.querySelector(".recommended_product_image").src = currentImage;
                          })
                        }
                      })
                    {% endif %}
                  })()
                </script>
                
              </div>
          {%- endcase -%}
        {%- endfor -%}
        <a href="{{ product.url }}" class="link product__view-details animate-arrow">
          {{ 'products.product.view_full_details' | t }}
          {% render 'icon-arrow' %}
        </a>
      </product-info>
    </div>
    {%- if section.settings.media_position == 'right' -%}
      {% comment %} Duplicate gallery to display after product content on tablet/desktop breakpoint {% endcomment %}
      <div class="grid__item product__media-wrapper small-hide">
        {% render 'product-media-gallery', variant_images: variant_images, is_duplicate: true %}
      </div>
    {%- endif -%}
  </div>

  {% render 'product-media-modal' variant_images: variant_images %}

  {% assign popups = section.blocks | where: 'type', 'popup' %}
  {%- for block in popups -%}
    <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
      <div
        role="dialog"
        aria-label="{{ block.settings.text }}"
        aria-modal="true"
        class="product-popup-modal__content"
        tabindex="-1"
      >
        <button
          id="ModalClose-{{ block.id }}"
          type="button"
          class="product-popup-modal__toggle"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-close' %}
        </button>
        <div class="product-popup-modal__content-info">
          <h1 class="h2">{{ block.settings.page.title }}</h1>
          {{ block.settings.page.content }}
        </div>
      </div>
    </modal-dialog>
  {%- endfor -%}

  {%- if product.media.size > 0 -%}
    <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if first_3d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
    <script src="{{ 'product-model.js' | asset_url }}" defer></script>
  {%- endif -%}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function isIE() {
        const ua = window.navigator.userAgent;
        const msie = ua.indexOf('MSIE ');
        const trident = ua.indexOf('Trident/');

        return msie > 0 || trident > 0;
      }

      if (!isIE()) return;
      const hiddenInput = document.querySelector('#{{ product_form_id }} input[name="id"]');
      const noScriptInputWrapper = document.createElement('div');
      const variantPicker = document.querySelector('variant-selects[data-section="{{ section.id }}"]');
      noScriptInputWrapper.innerHTML = document.querySelector(
        '.product-form__noscript-wrapper-{{ section.id }}'
      ).textContent;
      variantPicker.outerHTML = noScriptInputWrapper.outerHTML;

      document.querySelector('#Variants-{{ section.id }}').addEventListener('change', function (event) {
        hiddenInput.value = event.currentTarget.value;
      });
    });
  </script>

  {%- liquid
    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}

  <script type="application/ld+json">
    {
      "@context": "http://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {% if seo_media -%}
        "image": [
          {{ seo_media | image_url: width: 1920 | prepend: "https:" | json }}
        ],
      {%- endif %}
      "description": {{ product.description | strip_html | json }},
      {% if product.selected_or_first_available_variant.sku != blank -%}
        "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- endif %}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type" : "Offer",
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
            {%- if variant.barcode.size == 12 -%}
              "gtin12": {{ variant.barcode }},
            {%- endif -%}
            {%- if variant.barcode.size == 13 -%}
              "gtin13": {{ variant.barcode }},
            {%- endif -%}
            {%- if variant.barcode.size == 14 -%}
              "gtin14": {{ variant.barcode }},
            {%- endif -%}
            "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "price" : {{ variant.price | divided_by: 100.00 | json }},
            "priceCurrency" : {{ cart.currency.iso_code | json }},
            "url" : {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  </div>
</section>

