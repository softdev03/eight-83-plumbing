                      outline: solid 1px var(--navButtonColor);
                      outline-offset: 2px;
                    {% elsif block.settings.page_style == "style_2" %}
                      transform: scale(0.8);
                      outline: solid 1px var(--navButtonColor);
                      outline-offset: 2px;
                    {% elsif block.settings.page_style == "style_3" %}
                      background-color: transparent;
                      outline: solid 1px var(--navButtonColor);
                      outline-offset: 2px;
                    {% elsif block.settings.page_style == "style_4" %}
                      transform: scaleX(0.8);
                      background-color: transparent;
                      outline: solid 1px var(--navButtonColor);
                      outline-offset: 2px;
                    {% elsif block.settings.page_style == "style_5" %}
                      height: 6px;
                    {% endif %}
                  }

            
