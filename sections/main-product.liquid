                      border-radius: 500px;
                      margin-inline: 5px;
                    {% elsif block.settings.page_style == "style_2" %}
                      height: calc(var(--navButtonSize) / 3);
                      width: calc(var(--navButtonSize) / 3);
                      border-radius: 500px;
                      margin-inline: 5px;
