                    width: calc({{ item_count }} * 100%);
                    display: flex;
                    transition: all ease 0.3s;
                  }
                  .product_slide {
                    flex: 1;
                    margin-inline: calc(8px + var(--navButtonSize));
                  }
                  .slideShow_nav {
                    position: absolute;
                    top: 50%;
                    left: 0px;
                    height: var(--navButtonSize);
                    width: var(--navButtonSize);
                    border-radius: 50%;
                    display: block!important;
                    transform: translate(0px, -50%);
                    cursor: pointer;
                    z-index: 1;
                  }
                  .slideShow_nav.next {
                    left: unset;
                    right: 0px;
                    transform: translate(0px, -50%);
                  }
                  .slide_nav_conainer {
                    position: absolute;
                    bottom: 10px;
                    left: 50%;
                    transform: translateX(-50%);
                    display: flex;
                    align-items: flex-end;
                    justify-content: center;
                  }
                  .slide_nav {
                    display: block!important;
                    background-color: var(--navButtonColor);
                    cursor: pointer;
                    transition: all ease 0.3s;

                    {% if block.settings.page_style == "style_1" %}
