{{ 'support-information.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} .shopify-support-information {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .shopify-support-information {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-support-information page-width">
    {%- for block in section.blocks -%}
      <div class="support-item text-upper-wrapper">
        <h1 class="heading line-height-1_1 font-900 m-0 text-center text-very-dark">{{ block.settings.heading }}</h1>
        <p class="text line-height-1_1 font-800 m-0 text-center text-black">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
</div>
{% schema %}
  {
    "name": "Support Information",
    "tag": "section",
    "class": "shopify-section--support-information",
    "settings": [
      {
        "type": "header",
        "content": "Padding Setting"
      },
      {
        "type": "range",
        "id": "desktop_padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Desktop Padding Top",
        "default": 50 
      },
      {
        "type": "range",
        "id": "desktop_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Desktop Padding Bottom",
        "default": 50
      },
      {
        "type": "range",
        "id": "mobile_padding_top",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Mobile Padding Top",
        "default": 50 
      },
      {
        "type": "range",
        "id": "mobile_padding_bottom",
        "min": 0,
        "max": 150,
        "step": 2,
        "unit": "px",
        "label": "Mobile Padding Bottom",
        "default": 50
      }
    ],
    "blocks": [
        {
            "type": "support_item",
            "name": "Support Item",
            "limit": 3,
            "settings": [
                {
                  "type": "text",
                  "id": "heading",
                  "label": "Heading"
                },
                {
                  "type": "text",
                  "id": "text",
                  "label": "Text"
                }
            ]
        }
    ],
    "presets": [
      {
        "name": "Support Information",
        "settings": {
        }
      }
    ]
  }
{% endschema %}