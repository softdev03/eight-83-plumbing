{{ 'booking-service.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id}} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id}} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-booking-service page-width" id="{{ section.settings.section_id }}">
  <div class="card">
    <h1 class="m-0 heading">{{ section.settings.heading }}</h1>
    <div class="booking-service-items-list">
      {%- for block in section.blocks -%}
        <div class="booking-service-item" price="{{ block.settings.price }}">
          <p class="m-0 service-name">{{ block.settings.service_name }}</p>
          {% comment %} {%- if block.settings.price < 0 -%}
            <p class="m-0 service-price">{{- block.settings.price | times: -100 |  money -}}</p>
          {%- else -%}
            <p class="m-0 service-price">{{- block.settings.price |  times: 100 |  money -}}</p>
          {%- endif -%} {% endcomment %}
        </div>
      {%- endfor -%}
    </div>
    <a href="{{ section.settings.target_section_id }}" class="next-step disable">
      {{- section.settings.next_step_text -}}
    </a>
  </div>
</div>
{% schema %}
{
  "name": "Booking Service System",
  "tag": "section",
  "class": "shopify-section--booking-service shopify-section booking-online show",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "target_section_id",
      "label": "Target Section Id"
    },
    {
      "type": "text",
      "id": "next_step_text",
      "label": "Next Step Text"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "service_type",
      "name": "Service Name",
      "settings": [
        {
          "type": "text",
          "id": "service_name",
          "label": "Service Name"
        },
        {
          "type": "number",
          "id": "price",
          "label": "Price ($)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Booking Service System",
      "settings": {}
    }
  ]
}
{% endschema %}
