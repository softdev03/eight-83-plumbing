                "id": "btn_bg_color_1",
                "label": "Button background color",
                "default": "#fff"
            },
            {
                "type": "color",
                "id": "btn_label_color_1",
                "label": "Button label color",
                "default": "#000"
            },
            {
                "type": "header",
                "content": "Button 2"
            },
            {
                "type": "text",
                "id": "button_label_2",
