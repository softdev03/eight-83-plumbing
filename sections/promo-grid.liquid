            {
                "type": "select",
                "id": "text_align-vertical",
                "options": [
                    {
                        "value": "top",
                        "label": "Top"
                    },
                    {
                        "value": "middle",
                        "label": "Middle"
                    },
                    {
                        "value": "bottom",
                        "label": "Bottom"
                    }
                ],
                "default": "middle",
