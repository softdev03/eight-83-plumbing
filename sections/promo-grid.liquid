{%- style -%}
.promotion-grid {
	width: 100%;
	display: block;
    {% if section.settings.section_size == 'full-width' %}
    	padding-left:15px;
        padding-right:15px;
    {% endif %}
}

.section-{{ section.id }}.promotion-grid {
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
}
  
.section-container {
	width: 100%;
	max-width: 1400px;
    padding: 0 15px;
	margin: 0 auto;
	display: block;
}
  
.promotion-grid-row {
	margin-left: -15px;
	margin-right: -15px;
	display: flex;
	flex-wrap: wrap;
}

.promotion-grid-col {
	width: 50%;
	float: left;
	padding: 0 15px;
    margin: 15px 0;
}

.promotion-grid-block {
	width: 100%;
	display: block;
	height: 100%;
	position: relative;
}

.promotion-grid-image svg.my-custom-class {
	background: #333;
}

.promotion-grid-image {
	width: 100%;
	height: 100%;
	display: block;
}

.promotion-grid-image * {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.promotion-grid-detail {
	position: absolute;
	left: 10px;
	right: 10px;
	top: 10px;
	bottom: 10px;
	display: flex;
    padding: 15px;	
}  

.promotion-detail-vertical-align-middle {
    align-items: center;
}
  
.promotion-detail-horizontal-align-center {
    justify-content: center;
    text-align: center;
} 
  
.promotion-detail-vertical-align-top {
    align-items: flex-start;
}
  
.promotion-detail-horizontal-align-left {
    justify-content: flex-start;
    text-align: left;
} 
  
.promotion-detail-vertical-align-bottom {
    align-items: flex-end;
}
  
.promotion-detail-horizontal-align-right {
    justify-content: flex-end;
    text-align: right;
}

.promotion-detail__heading.h2 {
    font-size: 24px;
    line-height: 34px;
}

.promotion-detail__heading.h1 {
    font-size: 36px;
    line-height: 46px;
}

.promotion-detail__heading.h0 {
    font-size: 58px;
    line-height: 68px;
} 
  
.promotion-detail__text-subtitle * {
    font-size: 22px;
    line-height: 30px;
}  

.promotion-grid-detail-inner .button {
    padding: 15px 30px;
    text-decoration: none;
    font-size: 16px;
    line-height: 20px;
    display: inline-block;
    margin: 5px 10px;
}  

.promotion-detail-buttons {
	margin-top: 15px;
	display: inline-block;
	margin-left: -10px;
	margin-right: -10px;
}

@media screen and (max-width: 749px) {

.section-{{ section.id }}.promotion-grid {
    padding-top:{{ section.settings.mobile_padding_top }}px;
    padding-bottom:{{ section.settings.mobile_padding_bottom }}px;
}  

.promotion-grid-col {
	width: 100%;
}  
  
.promotion-detail__heading.h1 {
    font-size: 30px;
    line-height: 40px;
}
  
.promotion-detail__heading.h0 {
    font-size: 44px;
    line-height: 54px;
}
  
.promotion-detail__text-subtitle * {
    font-size: 20px;
    line-height: 28px;
}
   
}    
{%- endstyle -%} 

<div class="promotion-grid section-{{ section.id }}">
  {% if section.settings.section_size == 'container' %}
    <div class="section-container">
  {% endif %}

      <div class="promotion-grid-row">
          {% for block in section.blocks %}
              <div class="promotion-grid-col">
                  <div class="promotion-grid-block">
            
                      <div class="promotion-grid-image">
                          {% if block.settings.image != blank %}
                          <img 
                            src="{{ block.settings.image | img_url: 'master' }}"
                            alt="{{ block.settings.image.alt }}"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                            >
                          {% else %}
                            {{ 'collection-1' | placeholder_svg_tag: 'my-custom-class' }}
                          {% endif %}
                      </div>

                      <div class="promotion-grid-detail promotion-detail-vertical-align-{{ block.settings.text_align-vertical }} promotion-detail-horizontal-align-{{ block.settings.text_align-horizontal }}"
                        style="{% if block.settings.enable_border != blank %}border: 1px solid {{ block.settings.border_color }};{% endif %}"
                        >
                            <div class="promotion-grid-detail-inner">
                              
                                {% if block.settings.heading != blank %}
                                <h2
                                    class="promotion-detail__heading {{ block.settings.heading_size }}"
                                    style="color:{{ block.settings.heading_color }}; text-transform: {{ block.settings.heading_transform }}"
                                >
                                    {{ block.settings.heading }}
                                </h2>
                                {% endif %}
            
                                {% if block.settings.text != blank %}
                                <div
                                    class="promotion-detail__text rte promotion-detail__text-{{ block.settings.text_style }}"
                                    style="color:{{ block.settings.text_color }}"
                                >
                                    {{ block.settings.text }}
                                </div>
                                {% endif %}
            
                                {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                                <div class="promotion-detail-buttons">
                                      {%- if block.settings.button_label_1 != blank -%}
                                      <a
                                          href="{{ block.settings.button_link_1 }}"
                                          class="button"
                                          style="background:{{ block.settings.btn_bg_color_1 }}; color:{{ block.settings.btn_label_color_1 }};"
                                      >
                                          {{ block.settings.button_label_1 | escape }}
                                      </a>
                                      {%- endif -%}
            
                                      {%- if block.settings.button_label_2 != blank -%}
                                      <a
                                          href="{{ block.settings.button_link_2 }}"
                                          class="button"
                                          style="background:{{ block.settings.btn_bg_color_2 }}; color:{{ block.settings.btn_label_color_2 }};"
                                      >
                                          {{ block.settings.button_label_2 | escape }}
                                      </a>
                                      {%- endif -%}
                                </div>
                                {%- endif -%}
            
                            </div>
                      </div>
                    
                  </div>
              </div>
          {% endfor %}
      </div>
      
  {% if section.settings.section_size == 'container' %}    
    </div>
  {% endif %}
</div>


{% schema %}
{
"name": "Promotion grid",
"class": "section",  
"settings": [
    {
        "type": "select",
        "id": "section_size",
        "options": [
            {
                "value": "container",
                "label": "Container"
